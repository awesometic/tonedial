{
  "name": "tonedial",
  "version": "0.1.9",
  "description": "Set a coding agent's manner once and keep it across every project.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "tonedial": "./dist/bin.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "build": "tsgo -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "npm run typecheck && npm run build && node scripts/extract-fixtures.ts --check && node scripts/regenerate-packs.ts --check && node --test",
    "fixtures": "node scripts/extract-fixtures.ts",
    "packs": "node scripts/regenerate-packs.ts",
    "prepublishOnly": "npm test && node scripts/check-release.mjs",
    "test:golden": "node --test test/output-golden.test.ts test/frame-golden.test.ts test/image-golden.test.ts",
    "test:pty": "npm run build && node --test test/pty.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  },
  "keywords": [
    "cli",
    "claude",
    "codex",
    "antigravity",
    "agent",
    "prompt",
    "tone",
    "personality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesometic/tonedial.git"
  }
}
